    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "最终请求成功与失败 RPM；内部渠道重试不会重复增加最终请求数。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "RPM",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "rpm"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (result) (rate(newapi_relay_requests_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",relay_format=~\"$relay_format\"}[5m])) * 60",
          "legendFormat": "{{result}} RPM",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Final request outcome trend",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "最终 Relay 请求总耗时分位数；按选择的 relay format 和实例聚合。P95/P99 阈值按 cluster/job/relay_format 单独配置，默认不存在，因此阈值线显示 No data；P95 至少需要 5 分钟 50 个最终请求，P99 至少需要 100 个，且均需持续 10 分钟才告警。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "seconds",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/threshold/" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(newapi_relay_duration_seconds_bucket{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",relay_format=~\"$relay_format\"}[5m])))",
          "legendFormat": "P50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(newapi_relay_duration_seconds_bucket{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",relay_format=~\"$relay_format\"}[5m])))",
          "legendFormat": "P95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(newapi_relay_duration_seconds_bucket{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",relay_format=~\"$relay_format\"}[5m])))",
          "legendFormat": "P99",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max by (relay_format) (newapi_relay_latency_threshold_seconds{cluster=\"$cluster\",job=\"new-api\",relay_format=~\"$relay_format\",quantile=\"p95\"})",
          "legendFormat": "{{relay_format}} P95 threshold",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max by (relay_format) (newapi_relay_latency_threshold_seconds{cluster=\"$cluster\",job=\"new-api\",relay_format=~\"$relay_format\",quantile=\"p99\"})",
          "legendFormat": "{{relay_format}} P99 threshold",
          "range": true,
          "refId": "E"
        }
      ],
      "title": "Relay latency percentiles",
      "type": "timeseries"
    },
