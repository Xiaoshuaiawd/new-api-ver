    {"allValue": ".*", "current": {}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(up{cluster=\"$cluster\",job=\"new-api\"}, instance)", "hide": 0, "includeAll": true, "label": "Instance", "multi": true, "name": "instance", "options": [], "query": {"query": "label_values(up{cluster=\"$cluster\",job=\"new-api\"}, instance)", "refId": "PrometheusVariableQueryEditor-Instance"}, "refresh": 1, "regex": "", "sort": 1, "type": "query"},
    {"allValue": ".*", "current": {}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(newapi_task_queue_size{cluster=\"$cluster\",job=\"new-api\"}, platform)", "hide": 0, "includeAll": true, "label": "Platform", "multi": true, "name": "platform", "options": [], "query": {"query": "label_values(newapi_task_queue_size{cluster=\"$cluster\",job=\"new-api\"}, platform)", "refId": "PrometheusVariableQueryEditor-Platform"}, "refresh": 1, "regex": "", "sort": 1, "type": "query"}
  ]},
