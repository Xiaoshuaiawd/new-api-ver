          "editorMode": "code",
          "expr": "sum(rate(newapi_task_poll_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",platform=~\"$platform\",result=\"error\"}[5m])) / clamp_min(sum(rate(newapi_task_poll_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",platform=~\"$platform\"}[5m])), 0.000001)",
          "legendFormat": "轮询错误率",
