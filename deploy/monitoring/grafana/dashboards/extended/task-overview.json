      "pluginVersion": "12.1.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(newapi_task_submissions_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",platform=~\"$platform\"}[5m])) * 60",
          "legendFormat": "提交 RPM",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "任务提交 RPM",
      "type": "stat"
    },
