      "pluginVersion": "12.1.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, platform, result) (rate(newapi_task_duration_seconds_bucket{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",platform=~\"$platform\"}[15m])))",
          "legendFormat": "P50 / {{platform}} / {{result}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, platform, result) (rate(newapi_task_duration_seconds_bucket{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",platform=~\"$platform\"}[15m])))",
          "legendFormat": "P95 / {{platform}} / {{result}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "任务耗时 P50 / P95",
      "type": "timeseries"
