  },
  "description": "new-api Go 运行时与进程资源监控。",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "程序实例状态",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按实例横向比较 Go 堆内存、协程数量和进程 CPU 使用核数。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Go 堆内存"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "进程 CPU 核数"
            },
            "properties": [
              {
                "id": "unit",
                "value": "cores"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "12.1.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "go_memstats_heap_alloc_bytes{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\"}",
          "legendFormat": "堆内存",
          "range": false,
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "go_goroutines{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\"}",
          "legendFormat": "协程",
          "range": false,
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(process_cpu_seconds_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\"}[5m])",
          "legendFormat": "进程 CPU",
          "range": false,
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "title": "程序实例实时状态",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "instance": "实例",
              "Value #A": "Go 堆内存",
              "Value #B": "协程数",
              "Value #C": "进程 CPU 核数"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
