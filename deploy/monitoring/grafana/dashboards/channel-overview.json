      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(newapi_channel_attempts_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",channel_id=~\"$channel_id\",result=\"success\"}[5m])) / clamp_min(sum(rate(newapi_channel_attempts_total{cluster=\"$cluster\",job=\"new-api\",instance=~\"$instance\",channel_id=~\"$channel_id\"}[5m])), 0.000001)",
