global:
  resolve_timeout: 5m

route:
  receiver: new-api-webhook-warning
  group_by:
    - alertname
    - cluster
    - job
    - relay_format
    - channel_id
    - instance
    - database
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: new-api-webhook-critical
      matchers:
        - severity="critical"
      repeat_interval: 1h
    - receiver: new-api-webhook-warning
      matchers:
        - severity="warning"
      repeat_interval: 4h

inhibit_rules:
  - source_matchers:
      - alertname="NewAPIServiceSuccessRateCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIServiceSuccessRateLow"
      - severity="warning"
    equal:
      - cluster
      - job
  - source_matchers:
      - alertname="NewAPIDBPoolUtilizationCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIDBPoolUtilizationHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
      - database
  - source_matchers:
      - alertname="NewAPIRelayP99LatencyHigh"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIRelayP95LatencyHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - relay_format
  - source_matchers:
      - alertname="NewAPIRelayInflightCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIRelayInflightHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - relay_format
  - source_matchers:
      - alertname="NewAPIChannelFirstTokenWaitingCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIChannelFirstTokenWaitingHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - channel_id
  - source_matchers:
      - alertname="NewAPIStreamFirstTokenWaitingCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIStreamFirstTokenWaitingHigh"
      - severity="warning"
    equal:
      - cluster
      - job
  - source_matchers:
      - alertname="NewAPIChannelDurationP95Critical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIChannelDurationP95High"
      - severity="warning"
    equal:
      - cluster
      - job
      - channel_id
  - source_matchers:
      - alertname="NewAPIChannelTTFTP95Critical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIChannelTTFTP95High"
      - severity="warning"
    equal:
      - cluster
      - job
      - channel_id
  - source_matchers:
      - alertname="NewAPIChannelFirstByteP95Critical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIChannelFirstByteP95High"
      - severity="warning"
    equal:
      - cluster
      - job
      - channel_id
  - source_matchers:
      - alertname="NewAPIChannelInflightCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIChannelInflightHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - channel_id
  - source_matchers:
      - alertname="NewAPIHostCPUCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIHostCPUHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIHostMemoryCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIHostMemoryHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIHostFilesystemSpaceCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIHostFilesystemSpaceHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
      - device
      - mountpoint
  - source_matchers:
      - alertname="NewAPIProcessCPUCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIProcessCPUHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIProcessFDCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIProcessFDHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIPostgresConnectionsCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIPostgresConnectionsHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIRedisMemoryCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIRedisMemoryHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance
  - source_matchers:
      - alertname="NewAPIMySQLConnectionsCritical"
      - severity="critical"
    target_matchers:
      - alertname="NewAPIMySQLConnectionsHigh"
      - severity="warning"
    equal:
      - cluster
      - job
      - instance

receivers:
  - name: new-api-webhook-warning
    webhook_configs:
      - url: http://feishu-alert-webhook:8080/api/v1/alerts
        send_resolved: true
        timeout: 15s
  - name: new-api-webhook-critical
    webhook_configs:
      - url: http://feishu-alert-webhook:8080/api/v1/alerts
        send_resolved: true
        timeout: 15s
